rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The current workspace and legacy archive go through the authenticated API.
    // Runtime IAM permits writes only to clingraph-v2, and only reads to the archive.
    match /clinical_conversations/{document=**} { allow read, write: if false; }
    match /session_groups/{document=**} { allow read, write: if false; }
    match /user_settings/{document=**} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
