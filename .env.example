# Firebase is the default. Use sqlite for the existing offline workspace.
CLINGRAPH_STORAGE=firebase
PORT=3000
# Firebase public client configuration defaults to firebase-applet-config.json.
FIREBASE_PROJECT_ID=room-furnishing
FIRESTORE_DATABASE_ID=clingraph-v2
LEGACY_FIRESTORE_DATABASE_ID=ai-studio-clinicalconversa-3ce6f1dc-daba-4e40-8425-55a414691cb0
# Deployment can use a dedicated private bucket; see DEPLOYMENT.md.
FIREBASE_STORAGE_BUCKET=room-furnishing-clingraph-data
# Local Firebase development requires: gcloud auth application-default login
# Cloud Run uses its attached service account automatically.

# SQLite mode only. This file is preserved when using Firebase.
CLINGRAPH_DB_PATH=data/clingraph.sqlite
CLINGRAPH_AI_TIMEOUT_MS=180000
# Fallback for API requests without a concurrency selection (1-32).
# The app's AI Settings > Clinical annotation > Parallel utterances takes precedence.
CLINGRAPH_AI_CONCURRENCY=4
# SQLite only; defaults to logs/ai-requests.jsonl beside the database.
# Firebase mode writes structured diagnostics to stdout / Cloud Logging.
# CLINGRAPH_AI_LOG_PATH=data/logs/ai-requests.jsonl

# Optional server-side Gemini key. Provider settings can also be set in the app.
GEMINI_API_KEY=

# Optional: enables UMLS terminology lookup through NLM's service.
UMLS_API_KEY=
